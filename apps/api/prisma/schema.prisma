generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// A harmless migration marker. Business entities arrive in milestone 3.
model SystemMetadata {
  key   String @id
  value String
}

enum RecordKind {
  PAYMENT
  SETTLEMENT
  REFUND
}
enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
enum RowOutcome {
  ACCEPTED
  DUPLICATE
  REJECTED
  QUARANTINED
}
model ImportBatch {
  id String @id @default(uuid())
  kind RecordKind
  fileName String
  contentHash String
  rawCsv String @db.Text
  status ImportStatus @default(QUEUED)
  total Int @default(0)
  accepted Int @default(0)
  duplicate Int @default(0)
  rejected Int @default(0)
  quarantined Int @default(0)
  attempts Int @default(0)
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  requestedById String?
  requestedByLabel String?
  rows ImportRow[]
  records LedgerRecord[]
  @@unique([kind, contentHash])
  @@index([status, createdAt])
}
model ImportRow {
  id String @id @default(uuid())
  batchId String
  batch ImportBatch @relation(fields: [batchId], references: [id])
  rowNumber Int
  outcome RowOutcome
  reference String?
  transactionRef String?
  existingTransactionRef String?
  reason String?
  raw Json
  @@unique([batchId, rowNumber])
  @@index([outcome])
}
model LedgerRecord {
  kind RecordKind
  reference String
  transactionRef String
  amountPaise BigInt
  feePaise BigInt @default(0)
  netPaise BigInt @default(0)
  currency String @default("INR")
  occurredAt DateTime
  fingerprint String
  importBatchId String
  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])
  @@id([kind, reference])
  @@index([transactionRef])
}
model ReconciliationRun {
  id String @id @default(uuid())
  ruleVersion String
  snapshotHash String
  createdAt DateTime @default(now())
  paymentCount Int
  matchedCount Int
  exceptionCount Int
  groupCount Int
  durationMs Int
  sourceCounts Json
  items ReconciliationItem[]
  investigations Investigation[]
  @@unique([ruleVersion, snapshotHash])
}
model ReconciliationItem {
  id String @id @default(uuid())
  runId String
  run ReconciliationRun @relation(fields: [runId], references: [id])
  transactionRef String
  status String
  codes String[]
  details Json
  @@unique([runId, transactionRef])
  @@index([runId, status])
}

enum UserRole {
  VIEWER
  OPERATOR
}
enum InvestigationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
model User {
  id String @id @default(uuid())
  email String @unique
  displayName String
  role UserRole
  passwordHash String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  assignments Investigation[]
  notes InvestigationNote[]
  auditEvents AuditEvent[]
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields:[userId], references:[id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model LoginThrottle {
  key String @id
  count Int
  resetsAt DateTime
}
model Investigation {
  id String @id @default(uuid())
  transactionRef String @unique
  status InvestigationStatus @default(OPEN)
  assigneeId String?
  assignee User? @relation(fields:[assigneeId], references:[id])
  version Int @default(1)
  latestRunId String
  latestRun ReconciliationRun @relation(fields:[latestRunId], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes InvestigationNote[]
  summaries AiRequest[]
  @@index([status, updatedAt])
}
model InvestigationNote {
  id String @id @default(uuid())
  investigationId String
  investigation Investigation @relation(fields:[investigationId], references:[id])
  authorId String
  author User @relation(fields:[authorId], references:[id])
  kind String
  body String
  createdAt DateTime @default(now())
  @@index([investigationId, createdAt])
}
model AuditEvent {
  id String @id @default(uuid())
  actorId String?
  actor User? @relation(fields:[actorId], references:[id])
  actorLabel String
  action String
  entityType String
  entityId String
  details Json
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entityId, createdAt])
}


model AiBudget {
  id String @id
  limitMicros Int @default(1000000)
  spentMicros Int @default(0)
  reservedMicros Int @default(0)
}
model AiRequest {
  id String @id
  investigationId String
  investigation Investigation @relation(fields:[investigationId], references:[id])
  actorId String
  sourceHash String
  context Json
  model String
  promptVersion String
  priceVersion String
  status String @default("PENDING")
  reservedMicros Int
  chargedMicros Int @default(0)
  inputTokens Int?
  outputTokens Int?
  durationMs Int?
  output Json?
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([investigationId, createdAt])
  @@index([investigationId, sourceHash, status])
}
