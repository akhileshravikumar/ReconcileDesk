{
  "name": "reconciledesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "generate": "npm run db:generate --workspace @reconciledesk/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace @reconciledesk/api",
    "build": "npm run build --workspaces",
    "check": "npm run generate && npm run lint && npm run typecheck && npm test && npm run build",
    "dev:web": "npm run dev --workspace @reconciledesk/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
