{
  "name": "@reconciledesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "smoke": "node dist/smoke.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1",
    "ioredis": "6.0.0",
    "bullmq": "6.3.11"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "supertest": "7.3.1",
    "@types/node": "24.10.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1"
  }
}
