{
  "name": "@reconciledesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "smoke": "node dist/smoke.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "fixtures": "node --import tsx src/fixtures.ts",
    "evaluate": "node --import tsx src/evaluate.ts",
    "verify:data": "node dist/verify-data.js",
    "test:db": "vitest run tests/database.integration.test.ts tests/auth.integration.test.ts tests/summaries.integration.test.ts --no-file-parallelism",
    "verify:db": "node dist/verify-database.js",
    "seed:demo": "node dist/seed-demo.js",
    "evaluate:ai": "node --import tsx src/evaluate-summaries.ts",
    "evaluate:ai:report": "node --import tsx src/report-summary-evaluation.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "csv-parse": "7.0.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
